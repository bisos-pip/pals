#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =SpreadPlantedCmndService= for a PALS's NGINX virtual-host (capWebVd) --- serves its built site

The same file for every PALS --- planted (as a symlink to this one in bisos.pals) in the PALS's cbm/.
Its directory is its parameter: the PALS is the nearest directory above it with uri/here/value, which
is the vhost's server_name (e.g. libre-halaal.org.here); the root is that PALS's site/dist (astro build,
pals-assemble.cs -i siteBuild). The name resolves through the palsHere block of /etc/hosts
(pals-here-dns.spcs); nginx listens on :80 and picks the vhost by server_name.
#+end_org """

import os

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo

from bisos.pals import palsHere

palsDir = palsHere.palsDirOfPlant(palsHere.plantOf())
serverName = palsHere.uriHereOf(palsDir)
# Resolved, for nginx: a vhost does not depend on a symlink's being in place.
rootBaseDir = os.path.join(os.path.realpath(palsDir), "site", "dist")

def wvdConfigFunc() -> str:
    """webVd_nginxSites.atBaseSite, plus the site's own 404 page."""
    return f"""\
server {{
    listen 80;
    server_name {serverName};

    root {rootBaseDir};
    index index.html;

    location / {{
        try_files $uri $uri/ =404;
    }}

    error_page 404 /404.html;
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort="NA",
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo  # noqa: E402
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
