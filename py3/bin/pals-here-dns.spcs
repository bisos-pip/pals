#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =SpreadPlantedCmndService= for a PALS's .internal name: the list, then /etc/hosts

The same file for every PALS --- planted (usually as a symlink to this one in bisos.pals) in the PALS's
cbm/, next to its CBS. Its directory is its parameter: the PALS is the nearest directory above it with
uri/here/value (e.g. libre-halaal.org.internal); nothing PALS-specific is written here.

Planted on bisos.dnsCap's seed. palsHere.dnsCapSetup() names two /etc/hosts dblocks, banna's and
palsHere's (palsHereInfo.cs -i palsForEtcHosts), and has dnsCap_update first add the PALS's name to
/bisos/var/palsHere/uri.list (its 127.0.55.x address, assigned once). So the CBS's assemble runs:

    ./pals-here-dns.spcs -i dnsCap_update
#+end_org """

from bisos.dnsCap import dnsCap_seed  # noqa: F401  # _atExit_

from bisos.pals import palsHere

fqdn = palsHere.dnsCapSetup() or ""   # "" on the first pass, before the seed runs

from bisos.csSeed import csCmndsList_seedInfo  # noqa: E402
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("dnsCap_update",),
    csCmnd("dnsCap_ensureHostsDblock"),
    csCmnd("dnsCap_verify",),
    csCmnd("dnsCap_resolve", args=fqdn),
    csCmnd("dnsCap_fqdnPing", args=fqdn),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
