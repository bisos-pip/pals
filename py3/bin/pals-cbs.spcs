#!/usr/bin/env python

""" #+begin_org
* Overview and Relevant Pointers
pals-cbs.spcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
ws: An Web Service  --- /Service Component/ --- a PALS's Astro site at its .here name (uri/here/value)
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The same file for every PALS --- planted (as a symlink to this one in bisos.pals) in the PALS's cbm/,
next to pals-assemble.cs, pals-here-dns.spcs and pals-wvd.spcs. Its directory is its parameter: the
assemble it names is the pals-assemble.cs beside it.

No sbom (Node comes from the reactPlus leaf; Astro from site/package-lock.json) and no units (nginx
serves static files): only pals-assemble.cs, which builds the site and installs its dns entry and vhost.
#+end_org """

import os

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

from bisos.pals import palsHere

# Not resolved: this file is usually a symlink, and the assemble to run is the one in its own cbm/.
assemble = os.path.join(os.path.dirname(os.path.abspath(palsHere.plantOf())), "pals-assemble.cs")

cba_seed.setup(
    seedType="systemd",  # Extend using cba_sysd_seed.setup
    loader=None,
    sbom=None,
    assemble=assemble,
    materialize=None,
)

sysdUnitsListPals = [
]

cba_sysd_seed.setup(
    sysdUnitsList=sysdUnitsListPals,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
